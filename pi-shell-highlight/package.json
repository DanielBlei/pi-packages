{
	"name": "pi-shell-highlight",
	"version": "0.1.0",
	"description": "Shell command highlighting for pi: colors the name of each command and the inner language of a heredoc, for dialogs that ask to run it",
	"license": "Apache-2.0",
	"author": "Daniel Blei",
	"bugs": {
		"url": "https://github.com/DanielBlei/pi-packages/issues"
	},
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/DanielBlei/pi-packages.git",
		"directory": "pi-shell-highlight"
	},
	"homepage": "https://github.com/DanielBlei/pi-packages/tree/main/pi-shell-highlight#readme",
	"keywords": [
		"pi-package",
		"pi",
		"pi-extension",
		"pi-coding-agent",
		"syntax-highlighting",
		"shell",
		"bash"
	],
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"test": "node --test \"tests/**/*.test.ts\"",
		"typecheck": "tsc --noEmit"
	},
	"pi": {
		"extensions": [
			"./extension.ts"
		]
	},
	"exports": {
		"./highlight.ts": "./highlight.ts"
	},
	"files": [
		"extension.ts",
		"highlight.ts",
		"README.md",
		"CHANGELOG.md",
		"NOTICE"
	],
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*"
	}
}
