{
	"name": "pi-keeper",
	"version": "0.1.0",
	"description": "Permission modes for pi (default, auto and plan) with per-project allow, ask and deny rules and a plan you approve before any edit.",
	"license": "Apache-2.0",
	"author": "Daniel Blei",
	"bugs": {
		"url": "https://github.com/DanielBlei/pi-packages/issues"
	},
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/DanielBlei/pi-packages.git",
		"directory": "pi-keeper"
	},
	"homepage": "https://github.com/DanielBlei/pi-packages/tree/main/pi-keeper#readme",
	"keywords": [
		"pi-package",
		"pi",
		"pi-extension",
		"pi-coding-agent",
		"permissions",
		"policy",
		"modes",
		"approval",
		"plan-mode",
		"subagents"
	],
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"test": "node --test \"tests/**/*.test.ts\"",
		"test:unit": "node --test \"tests/unit/*.test.ts\"",
		"test:integration": "node --test \"tests/integration/*.test.ts\"",
		"typecheck": "tsc --noEmit",
		"bench": "node scripts/bench.ts",
		"prompt-weight": "node scripts/prompt-weight.ts",
		"check:charts": "node scripts/charts/check.ts",
		"rulebook-check": "node scripts/rulebook-check.ts",
		"rulebook-fires": "node scripts/rulebook-fires.ts"
	},
	"pi": {
		"extensions": [
			"./extensions/index.ts"
		],
		"prompts": []
	},
	"files": [
		"extensions",
		"prompts",
		"README.md",
		"CHANGELOG.md",
		"NOTICE"
	],
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	}
}
